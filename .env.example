# ============================================================
# MERCHANT ZONE - Environment Variables Template
# Copy this file to .env.local and set your own secrets
# ============================================================

# 32+ character random secret for iron-session
# Generate using: openssl rand -base64 32
SESSION_SECRET=your-secure-random-session-secret-here-32chars

# Initial Administrator Credentials (used for first-time DB seeding only)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=SetYourSecureAdminPassword123!

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/fintech_portal.db

# Private upload directory for payment verification screenshots (kept outside public/)
UPLOAD_DIR=./uploads

# Max upload file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
