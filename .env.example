# ==============================================================================
# MERCHANT ZONE - Environment Variables Configuration
# ==============================================================================
# For local development: Copy this file to .env.local and adjust values.
# For Render deployment: Add these variables under "Environment" in your Render Web Service.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER PRODUCTION VALUES (Recommended with Persistent Disk on /var/data)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# DATABASE_PATH=/var/data/merchant_zone.db
# UPLOAD_DIR=/var/data/uploads
# MAX_FILE_SIZE=5242880
# SESSION_SECRET=<generate a 32+ character random secret, e.g. using openssl rand -base64 32>
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=YourStrongProductionPassword123!
# NEXT_PUBLIC_BASE_URL=https://your-service-name.onrender.com

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT VALUES
# ------------------------------------------------------------------------------
NODE_ENV=development

# 32+ character random secret for iron-session cookie encryption
# Generate via: openssl rand -base64 32 (or any random string with 32+ characters)
SESSION_SECRET=your-secure-random-session-secret-here-32chars

# Initial Administrator Credentials (used for first-time DB seeding only)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=SetYourSecureAdminPassword123!

# SQLite database file path (can be relative in local dev or absolute in Render)
# Local: ./data/merchant_zone.db | Render: /var/data/merchant_zone.db
DATABASE_PATH=./data/merchant_zone.db

# Private upload directory for payment verification screenshots and custom QR codes
# Local: ./uploads | Render: /var/data/uploads
UPLOAD_DIR=./uploads

# Max upload file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# Public Base URL (used for absolute URL generation and redirects)
# Local: http://localhost:3000 | Render: https://<your-subdomain>.onrender.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
